<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/usr/bin/env ruby -wEutf-8
# Override of Markdown.tmbundle "New Subitem"
# Uses Rtim Support/lib/markdown_list.rb.

$:.unshift ENV['TM_BUNDLE_SUPPORT']
$:.unshift ENV['TM_SUPPORT_PATH']

require 'lib/markdown_list'
require 'lib/escape'

STDIN.set_encoding(Encoding::UTF_8)
STDOUT.set_encoding(Encoding::UTF_8)

if ENV['TM_SELECTED_TEXT'].to_s.empty?
	listtxt = $stdin.read

	offsetline = ENV['TM_LINE_NUMBER'].to_i - ENV['TM_INPUT_START_LINE'].to_i
	# TM_LINE_INDEX is UTF-8 bytes; Ruby 2+ indexes by character.
	index = MarkdownList.byte_col_to_char_col(ENV['TM_CURRENT_LINE'], ENV['TM_LINE_INDEX'].to_i)

	print MarkdownList.break_item(listtxt, offsetline, index, true) { |l| e_sn(l) }
else
	# Selection: delete it and start a new sub-item with what follows it.
	# Output replaces the selection, so emit just the break + new prefix.
	print "\n" + e_sn(MarkdownList.new_item_prefix(ENV['TM_CURRENT_LINE'], true)) + "$0"
end
</string>
	<key>fallbackInput</key>
	<string>scope</string>
	<key>input</key>
	<string>selection</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>^~</string>
	<key>name</key>
	<string>New Subitem</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>snippet</string>
	<key>outputLocation</key>
	<string>replaceInput</string>
	<key>scope</key>
	<string>text.html.markdown markup.list</string>
	<key>uuid</key>
	<string>CEAD359E-166F-4A1D-AC9F-2257F7BAE668</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
