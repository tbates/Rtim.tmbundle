<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/usr/bin/env ruby -wEutf-8
# Thin launcher: the real implementation lives in Support/lib so it stays
# editable, testable, and out of the plist XML. The first path keeps working
# after Rtim moves to ~/bin/tm/bundles because Application Support then holds
# a symlink to it; the scan covers direct checkouts anywhere.
candidates = [
  File.expand_path('~/Library/Application Support/TextMate/Bundles/Rtim.tmbundle/Support/lib/check_unused_uuids.rb'),
  *Dir[File.expand_path('~/bin/tm/bundles/*/Support/lib/check_unused_uuids.rb')].sort,
]
lib = candidates.find { |p| File.file?(p) }
abort 'check_unused_uuids.rb not found.' if lib.nil?
load lib
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>name</key>
	<string>Check for unused UUIDs</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>text</string>
	<key>outputLocation</key>
	<string>toolTip</string>
	<key>uuid</key>
	<string>F047BD64-E6B1-439A-BAE1-274A42EDA666</string>
	<key>version</key>
	<integer>3</integer>
</dict>
</plist>
