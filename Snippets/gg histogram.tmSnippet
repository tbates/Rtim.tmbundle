<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>content</key>
	<string>p = ggplot(df, aes(x = ${1:Age})) + geom_histogram(bins=30) + labs(x = "$1", title = "Graph of $1")
</string>
	<key>name</key>
	<string>gg histogram</string>
	<key>scope</key>
	<string>source.r</string>
	<key>tabTrigger</key>
	<string>gg</string>
	<key>uuid</key>
	<string>3FE0E3F1-2E9D-4186-B5C4-E6D1D4744B25</string>
</dict>
</plist>
